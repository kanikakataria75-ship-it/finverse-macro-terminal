# Finverse — copy to .env and fill only what you use. Everything here is optional:
# the terminal runs fully on free, keyless public data with no .env at all.

FINVERSE_HOST=127.0.0.1
FINVERSE_PORT=8777

# Angel One SmartAPI (real-time NSE ticks). OFF unless ANGEL_ENABLED=true.
# A failed login is never retried automatically (repeated bad MPINs lock the account).
ANGEL_ENABLED=false
API_KEY=
CLIENT_ID=
MPIN=
TOTP_SECRET=

# Telegram push for fired alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Oracle can polish answers with a free local LLM: install Ollama, then `ollama pull llama3.2`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Tuning
QUOTE_INTERVAL=60
LIQ_FEED_MIN_USD=250000
SIGMA_ALERT=2.5
